# TIGA environment variables (copy to .env or set in office shell)
# Never commit real secrets.

# Admin portal (Streamlit) — change before LAN rollout
TIGA_ADMIN_USER=admin
TIGA_ADMIN_PASSWORD=change-me-before-office

# Enterprise compose (optional until Hunt passes real-corpus gates)
# TIGA_OPENAI_API_KEY=
# TIGA_ANTHROPIC_API_KEY=
# TIGA_LLM_API_KEY=

# Work directory override
# TIGA_WORK_DIR=D:/tiga_data

# Force scheduler mode
# TIGA_MODE=night
